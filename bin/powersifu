#!/bin/sh
# Launch the GTK application independently from the calling terminal.
set -eu

app=${POWERSIFU_APP_EXEC:-/usr/libexec/powersifu/powersifu-app}

if [ ! -x "$app" ]; then
    printf '%s\n' "PowerSifu installation is incomplete: $app is missing" >&2
    exit 127
fi

case "${1:-}" in
    --foreground)
        shift
        exec "$app" "$@"
        ;;
    --version)
        exec "$app" "$@"
        ;;
esac

if command -v setsid >/dev/null 2>&1; then
    setsid -f "$app" "$@" </dev/null >/dev/null 2>&1
else
    nohup "$app" "$@" </dev/null >/dev/null 2>&1 &
fi
